{
  "name": "espectro-captura",
  "productName": "Espectro Captura",
  "version": "1.2.1",
  "description": "Ver e ouvir qualquer placa de captura com controle de volume de verdade.",
  "author": "Espectro Soluções",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "instalador": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "br.com.espectrosolucoes.captura",
    "productName": "Espectro Captura",
    "copyright": "Espectro Soluções",
    "publish": [
      {
        "provider": "generic",
        "url": "https://espectrosolucoes.com.br/atualizacoes/espectro-captura/"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "complementos.js",
      "app/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icone.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Espectro Captura",
      "artifactName": "Espectro-Captura-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "mediabunny": "1.66.2"
  }
}
